{
	"schemaVersion": 1,
	"id": "rec-utils",
	"version": "${version}",
	"name": "Rec Utils",
	"description": "Utilities For Recording Scripted Minecraft Videos",
	"authors": [
		"DEAMJAVA"
	],
	"contact": {
		"homepage": "https://github.com/DEAMJAVA/RecUtils",
		"sources": "https://github.com/DEAMJAVA/RecUtils"
	},
	"license": "CC0-1.0",
	"icon": "assets/rec-utils/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "net.deamjava.rec_utils.RecUtils",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"rec-utils.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
